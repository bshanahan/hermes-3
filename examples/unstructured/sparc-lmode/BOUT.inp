# SPARC L-mode edge and scrape-off layer on a wall-conforming (GOAT) grid
#
# Equilibrium: 12.2 T, 8.5 MA lower single null "VV" of cfs-energy/SPARCPublic
# (LmodeLowerSingleNull/VV/equilibrium.geqdsk). The grid reaches from the core
# boundary (psi_N = 0.90) to the wall. See ../README.md for how to make it.
#
# Model: D+ and T+ ions (50:50), electrons, D and T fluid neutrals, anomalous
# cross-field diffusion, fixed-fraction neon radiation. Every wall face returns the
# ions that reach it as neutrals (recycle = 1). A pump in the private-flux region
# and a gas valve at the outboard midplane are in the input but off (pump_albedo = 1,
# puff_rate = 0); their positions are generic placeholders, not SPARC's. With them
# off, no particles and no convected power cross the core boundary in steady state.
# With the core density held fixed, every particle pumped is replaced through the
# core boundary and carries about 5/2 (Te + Ti) there (keV): keep the pumped flux
# small (pump_albedo 0.9999 or closer to 1) or balance it with the puff.
#
# This directory also holds the converged state (BOUT.restart.*.nc, 8 processes,
# grid ../sparc_lmode.grd.nc; its main numbers in reference_summary.json). Copy the
# directory, then continue from the state (under 3 minutes on 8 cores):
#     cp -r sparc-lmode run1
#     mpirun -np 8 hermes-3 -d run1 restart mesh:file=/full/path/to/sparc_lmode.grd.nc
# Without `restart` the run starts cold from the uniform values below, which takes
# far longer. Other grids or process counts: ../run_warm.sh. Any option can be set
# on the command line, e.g. power_core=20e6

######## Inputs an integrated-modelling framework would set ########
power_core = 17e6          # Heating power through the core boundary [W]
ion_power_fraction = 0.6   # Share of it given to the ions (half to D+, half to T+)
n_core = 8e19              # Electron density held on the core boundary [m^-3]
neon_fraction = 0.005      # n_Ne / n_e everywhere, for the neon radiation
D_perp = 0.3               # Anomalous particle diffusivity [m^2/s]
chi_perp = 0.15            # Anomalous heat diffusivity, ions and electrons [m^2/s]
recycle = 1                # Fraction of the ions reaching the wall returned as neutrals
pump_albedo = 1            # Fraction of the neutrals reaching the pump surface that is returned
                           # (1 = no pump; 0.9999 absorbs 0.01 %). Pump surface: see [recycling]
puff_rate = 0              # Gas puff [atoms/s], half D and half T. Valve: see [puff_d]
#####################################################################

# Neutral closure: the diffusive neutral flux is at most `neutral_limiter` times
# the one-sided free-streaming flux n vbar / 4
neutral_limiter = 1.0
neutral_gradient_floor = 0.1   # [1/m] smallest pressure-gradient scale in the limiter

# Starting state (uniform; the steady state does not depend on it)
n_start = 5e18             # Electron density [m^-3]
T_start = 10               # Temperature of ions and electrons [eV]
nn_start = 1e16            # Density of D and of T neutrals [m^-3], at 3 eV

nout = 60                  # Number of outputs
timestep = 478940          # Time between outputs: 95788 = 1 ms, so 5 ms
MXG = 0
MZ = 1

[mesh]
file = "sparc_lmode.grd.nc"

[unstructured]
# The skew correction of the neutral cross-field fluxes roughly doubles the number
# of time steps on GOAT grids; it stays on for the plasma. Set true for accuracy.
skew_correction_neutrals = false

[solver]   # Backward Euler with Newton iterations (PETSc SNES), direct solve of the Jacobian (MUMPS)
type = snes
pc_type = lu
max_nonlinear_iterations = 7
atol = 1e-6
rtol = 1e-5
stol = 1e-12
maxl = 260
matrix_free_operator = true
lag_jacobian = 50
jacobian_reuse = 10        # Re-use the Jacobian for up to 10 steps (rebuilt after a failure)
timestep = 10              # First time step, about 0.1 microseconds
max_snes_failures = 30
scale_vars = true
timestep_control = threshold_nonlinear_its
lower_its = 4              # Grow the step when Newton needs this many iterations or fewer
upper_its = 6              # Shrink it when Newton needs this many or more
diagnose = true

[petsc]
snes_type = newtonls
ksp_type = fgmres
pc_factor_mat_solver_type = mumps
snes_linesearch_type = basic
snes_ksp_ew

[hermes]
components = (d+, d, t+, t, e, sheath_boundary_unstructured, braginskii_collisions,
              braginskii_friction, braginskii_heat_exchange, braginskii_thermal_force,
              reactions, electron_force_balance, braginskii_conduction, recycling,
              fixed_fraction_neon, puff_d, puff_t)
Nnorm = 1e19
Bnorm = 1
Tnorm = 100

[sheath_boundary_unstructured]
diagnose = true
gamma_i = 2.5
gamma_e = 4.5

################ Deuterium ################

[d+]
type = evolve_density, evolve_momentum, evolve_pressure, anomalous_diffusion
diagnose = true
AA = 2
charge = 1
recycle_as = d
target_recycle = true
target_recycle_multiplier = recycle
neutral_pump = true                 # neutrals reaching the pump surface are absorbed
pump_recycle_multiplier = pump_albedo
anomalous_D = D_perp
anomalous_chi = chi_perp
thermal_conduction = true
kappa_limit_alpha = -1
core_density = 0.5 * n_core
core_power = 0.5 * ion_power_fraction * power_core

[Nd+]
function = 0.5 * n_start / hermes:Nnorm
bndry_all = neumann

[Pd+]
function = 0.5 * n_start / hermes:Nnorm * T_start / hermes:Tnorm
bndry_all = neumann

[NVd+]
function = 0
bndry_all = neumann

[d]
type = neutral_mixed, neutral_boundary
AA = 2
evolve_momentum = true
flux_limit = neutral_limiter
limiter_gradient_floor = neutral_gradient_floor
lag_limiter_gradient = true   # without this the solver stalls on GOAT grids
diagnose = true

[Nd]
function = nn_start / hermes:Nnorm
bndry_all = neumann

[Pd]
function = nn_start / hermes:Nnorm * 3 / hermes:Tnorm
bndry_all = neumann

[NVd]
function = 0
bndry_all = neumann

################ Tritium ################

[t+]
type = evolve_density, evolve_momentum, evolve_pressure, anomalous_diffusion
diagnose = true
AA = 3
charge = 1
recycle_as = t
target_recycle = true
target_recycle_multiplier = recycle
neutral_pump = true                 # neutrals reaching the pump surface are absorbed
pump_recycle_multiplier = pump_albedo
anomalous_D = D_perp
anomalous_chi = chi_perp
thermal_conduction = true
kappa_limit_alpha = -1
core_density = 0.5 * n_core
core_power = 0.5 * ion_power_fraction * power_core

[Nt+]
function = 0.5 * n_start / hermes:Nnorm
bndry_all = neumann

[Pt+]
function = 0.5 * n_start / hermes:Nnorm * T_start / hermes:Tnorm
bndry_all = neumann

[NVt+]
function = 0
bndry_all = neumann

[t]
type = neutral_mixed, neutral_boundary
AA = 3
evolve_momentum = true
flux_limit = neutral_limiter
limiter_gradient_floor = neutral_gradient_floor
lag_limiter_gradient = true   # without this the solver stalls on GOAT grids
diagnose = true

[Nt]
function = nn_start / hermes:Nnorm
bndry_all = neumann

[Pt]
function = nn_start / hermes:Nnorm * 3 / hermes:Tnorm
bndry_all = neumann

[NVt]
function = 0
bndry_all = neumann

################ Electrons ################

[e]
type = quasineutral, evolve_pressure, zero_current, anomalous_diffusion
diagnose = true
AA = 1/1836
charge = -1
anomalous_D = D_perp
anomalous_chi = chi_perp
thermal_conduction = true
kappa_limit_alpha = -1     # an electron heat-flux limiter stalls the solver on GOAT grids
core_power = (1 - ion_power_fraction) * power_core

[Pe]
function = n_start / hermes:Nnorm * T_start / hermes:Tnorm
bndry_all = neumann

################ Collisions, recycling, reactions, radiation ################

[braginskii_collisions]
electron_neutral = false
ion_neutral = false
neutral_neutral = false

[recycling]
species = d+, t+
# Pump surface (Rmin, Rmax, Zmin, Zmax in m; several boxes separated by |): the wall
# under the lower X-point, between the strike points, in GOAT's SPARC vessel
pump_boxes = "1.35, 1.525, -1.235, -1.205"

[puff_d]
type = wall_puff
species = d
locations = "2.43, 0.0"    # R, Z [m]; moved to the nearest wall face (outboard midplane)
total_rate = 0.5 * puff_rate
diagnose = true

[puff_t]
type = wall_puff
species = t
locations = "2.43, 0.0"
total_rate = 0.5 * puff_rate
diagnose = true

[reactions]
type = (
        d + e -> d+ + 2e,   # Deuterium ionisation
        d+ + e -> d,        # Deuterium recombination
        d + d+ -> d+ + d,   # Deuterium charge exchange
        t + e -> t+ + 2e,   # Tritium ionisation
        t+ + e -> t,        # Tritium recombination
        t + t+ -> t+ + t,   # Tritium charge exchange
        d + t+ -> d+ + t,   # D-T charge exchange
        t + d+ -> t+ + d,   # T-D charge exchange
       )

[fixed_fraction_neon]   # ADAS-based neon cooling curve
fraction = neon_fraction
diagnose = true

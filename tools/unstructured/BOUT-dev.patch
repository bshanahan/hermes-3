   const auto xy_offsets = ColoringStencil::getOffsets(n_square, n_taxi, n_cross);
+
+  // Cells coupled to the cell at (x, y). A flat-cell (unstructured) mesh
+  // file gives the coupling explicitly, as CSR arrays over the whole list of
+  // cells along y (us_jac_rowptr, us_jac_cols); otherwise the stencil
+  // offsets are used.
+  Array<int> us_rowptr;
+  Array<int> us_cols;
+  const bool unstructured = mesh->sourceHasVar("us_jac_rowptr");
+  if (unstructured) {
+    if (mesh->get(us_rowptr, "us_jac_rowptr") != 0
+        or mesh->get(us_cols, "us_jac_cols") != 0) {
+      throw BoutException("Could not read us_jac_rowptr and us_jac_cols from the mesh");
+    }
+    if (mesh->LocalNx != 1 or mesh->LocalNz != 1 or mesh->getNXPE() != 1) {
+      throw BoutException("Unstructured Jacobian pattern needs nx = 1 and nz = 1");
+    }
+    output_progress.write("Using Jacobian pattern from the mesh file\n");
+  }
+  // In the unstructured case the second entry of each pair is the position
+  // in the whole list, which may be on another processor
+  const auto coupled = [&](int x, int y) {
+    std::vector<std::pair<int, int>> result;
+    if (unstructured) {
+      const int cell = mesh->getGlobalYIndexNoBoundaries(y);
+      result.reserve(us_rowptr[cell + 1] - us_rowptr[cell]);
+      for (int k = us_rowptr[cell]; k < us_rowptr[cell + 1]; ++k) {
+        result.emplace_back(x, us_cols[k]);
+      }
+    } else {
+      result.reserve(xy_offsets.size());
+      for (const auto& [x_off, y_off] : xy_offsets) {
+        result.emplace_back(x + x_off, y + y_off);
+      }
+    }
+    return result;
+  };
+  // Global index of the first unknown at a point returned by `coupled`,
+  // or -1 if there is none
+  const auto pointIndex = [&](int xi, int yi, int zi) -> int {
+    if (unstructured) {
+      // Every cell holds the same unknowns, numbered in order along y
+      return yi * (n2d + n3d);
+    }
+    if ((xi < 0) || (yi < 0) || (xi >= mesh->LocalNx) || (yi >= mesh->LocalNy)) {
+      return -1;
+    }
+    return ROUND(index(xi, yi, zi));
+  };
+
